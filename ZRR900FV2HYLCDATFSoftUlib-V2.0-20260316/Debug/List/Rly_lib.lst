   1934          
   1935          /*
   1936          *******************************************************************
   1937          * Title:			void	App_UI_Calculate()
   1938          * Description:		功率计算
   1939          
   1940          *******************************************************************
   1941          */
   1942          
   1943          
   1944          
   1945          void 	App_PQ_Calculate()
   1946          {
