   1194                      }
   1195          			//l_fRelayTrip|=UnDZ;
   1196          			//*ACT_Pront=Un;
   1197          			//TZ_Logic();
   1198          		}
   1199                  if(!(*D_Udelay)&&!(*w_Flag&UnQD))
   1200                      l_fRelayTrip&=~UnDZ;               
