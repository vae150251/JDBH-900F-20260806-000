   1188          		{
   1189                      if((UI_buffer.UAB.Val<=*Set_U)&&(UI_buffer.UBC.Val<=*Set_U)&&(UI_buffer.UCA.Val<=*Set_U)&&(Umax_Val<=*Set_U))
   1190                      {
   1191                          *ACT_Pront=Un;
