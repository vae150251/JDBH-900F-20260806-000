   1160          			*D_Udelay=*D_Udelay>>1;
   1161          	}
   1162          	if(*w_Flag&UnQD)   //保护启动记时
   1163          		*D_Udelay+=1;  
   1164              
   1165          	
   1166              if(*Set_Unf!=3)
   1167              {
   1168          		if((Un<Umin_set)||(FLAG_FZ&FLG_PTDX))
   1169          		{    
