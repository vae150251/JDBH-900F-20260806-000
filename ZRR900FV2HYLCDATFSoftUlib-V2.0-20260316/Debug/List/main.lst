    435          void	SMP_Initialize() 					// 采样计算初始化函数
    436          {
    437          	SMP_point = 0;							// 采样区指针初始化
    438          	MEM_clear((u8 *)&SMP_buffer,12*256*2);	// 采样数据区清零
