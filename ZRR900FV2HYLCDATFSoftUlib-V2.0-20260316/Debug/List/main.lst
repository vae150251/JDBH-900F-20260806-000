    338          		  Numset=sizeof(SetBuff)/2;	
    339          	      FixValueTable=FixValueTableLN;
    340          		  NumOfSet=NumOfSetLN;
    341          		}
    342              SET_Init(Set_QFTZ.Type);		//根据保护类型读取定值
