    276          	        tEvtTab=tEvtTab_LN;	    
    277          		    NumOfEvent=NumOfEventLN;
    278          			//开入描述
    279          		    tDITab=tDITab_Default;
    280                      NumOfDI=NumOfDI_Default;
    281          			
    282          	         ybTab=ybTab_LN;
    283                     NumOfYB=NumOfYBLN;	
    284          		   P_YB_YX=(u16*)&BAK_YB.YB_YX;
    285          		   Numset=sizeof(SetBuff)/2;
