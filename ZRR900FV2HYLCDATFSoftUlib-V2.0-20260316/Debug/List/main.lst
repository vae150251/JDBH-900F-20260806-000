    361          /*
    362          *******************************************************************
    363          * Title:		void	XH_Make1() 
    364          * Description:		/信号灯处理函数//
    365          * InputParameter:	
    366          * Copyright:		 
    367          * Company:			 
    368          * Create Date:		2005.08.12
    369          * @author:			
    370          * @version:			V1.00
    371                   
    372          * Modify Record:
    373          *******************************************************************
    374          */
    375          
    376          
    377           u8   Signal_JY;
    378          
    379          //---------信号灯处理---------------------//
    380          void	XH_Make1() 
    381          {
    382          #ifndef  ZRR_YK
    383          
    384                if(FLAG_FZ&FLG_HWJ)
    385                    Trip_P(KC_LED_HZ);
    386                 else
    387                    Trip_F(KC_LED_HZ);
    388                 
    389                 if(FLAG_FZ&FLG_TWJ)
    390                    Trip_P(KC_LED_TZ);
    391                 else
    392                    Trip_F(KC_LED_TZ);       
    393          #endif 		
    394             if(Timer_KC)  return;
    395          	//I类告警
    396          	//II类告警
    397             
    398           #ifdef  ZRR900F_SDGJ  
    399             if(Flag_BHER)
    400                Trip_F(KC_BY1);
    401             else
    402          	  Trip_P(KC_BY1);
    403          #endif  
    404             
    405          		if(Flag_BHER||Flag_BHALM||l_fRelayAlarm)
    406          		{
    407          			 
    408          				Trip_P(KC_GJ);
    409           				
    410          		 
    411          		}
    412                  else
    413                       {
    414                                 Trip_F(KC_GJ);
    415                        }
    416                  if(Flag_BHER)  //装置故障关闭出口
    417                  {
    418                     Trip_F(KC_BHTZ);
    419                     Trip_F(KC_BHHZ);
    420          		   Trip_F(KC_YKH);
    421          		   Trip_F(KC_YKT);
    422          		   Trip_F(KC_BY1);
    423                  }
    424          	//信号保存
    425          		if(Signal_JY!=Run_Signal.uSignal)
    426          		{
    427          				Eep_Write_Signal(&Run_Signal);
    428          				Signal_JY=Run_Signal.uSignal;
    429          		}
    430          
    431          }
