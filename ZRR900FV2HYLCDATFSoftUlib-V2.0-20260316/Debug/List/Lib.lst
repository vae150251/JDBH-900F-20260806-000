   1271          u32	MIN32_3(u32 a,u32 b,u32 c)
   1272          	{
   1273          		u32 x;
   1274          		x=a;
   1275          		if(x>b)	x=b;
   1276          		if(x>c)	x=c;
   1277          		return(x);
