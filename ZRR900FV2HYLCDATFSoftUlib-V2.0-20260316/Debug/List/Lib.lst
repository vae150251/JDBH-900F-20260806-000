    465          u32 AbcFunc(u32 a, u32 b)
    466          {
    467          	if(a>=b) return a-b;
    468          	else return b-a;
    469          }
    470          
    471          s32 AbsFunc(s32 a, s32 b)
    472          {
    473          	if(a>=b) return a-b;
    474          	else return b-a;
    475          }
    476          
    477          float ABSFunc(float a, float b)
    478          {
    479          	if(a>=b) return a-b;
    480          	else return b-a;
    481          }
