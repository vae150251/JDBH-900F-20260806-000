   1571          
   1572          //一次完成平方、开方运算函数
   1573          //经过测试，该函数调用执行时间大多在140us左右,2005.12.9
   1574          //输入：两个32位整型数a,b
   1575          //输出：幅值=(a^2+b^2)^0.5
   1576          s32 SQRTINT(s32 a,s32 b)
   1577          {
   1578          	s32 L,S;
   1579          	a = a >= 0 ? a : -a;
   1580          	b = b >= 0 ? b : -b;
   1581          	if (a >= b)
   1582          	{
   1583          		L = a;
   1584          		S = b;
   1585          	}
   1586          	else
   1587          	{
   1588          		L = b;
   1589          		S = a;
   1590          	}
   1591          	if (S==0)
   1592          		return(L);
   1593          	if (L==0)
   1594          		return(0);		
   1595          	else
   1596          	{
   1597          		if (S<29300)
   1598          			return((S*S*5)/((L+L+L+S)*3)+L);
   1599          		else
   1600          			return((S*S)/((L+L+L+S)*3)*5+L);
   1601          	}
   1602          }
