   1535          
   1536          u16 Float_Hex(u8 uLowByte,u8 uHighByte)
   1537          {
   1538          u16 wHex;
   1539          	
   1540          	wHex=0;
   1541          	if(uHighByte&0x80)
   1542          	{
   1543          		uHighByte=~uHighByte;
   1544          		uHighByte++;
   1545          		wHex +=uLowByte;
   1546          		wHex=wHex>>uHighByte;
   1547          		if(uHighByte>0x0f)
   1548          		      wHex=0;
   1549          	}
   1550          	else
   1551          	{
   1552          		wHex +=uLowByte;
   1553          		wHex=wHex<<uHighByte;
   1554          	}
   1555          	wHex+=1;
   1556          	return wHex;
   1557          }
