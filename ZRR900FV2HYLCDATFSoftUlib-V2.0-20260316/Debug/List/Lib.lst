   1484          //二位小数 0x0080
   1485          u16 Hex2_FD(u16 Value)  
   1486          {
   1487          	 u8 i;
   1488          	 i=8;
   1489          	 if(Value==0)
   1490          		 return 0xff80;  
   1491          	 while(Value<0x8000)
   1492          	 {
   1493          		 Value <<=1;
   1494          		 i--;
   1495          	 }
   1496          	 Value=Value&0xff00;
   1497          	 Value+=i;
   1498          	 return Value;
   1499          }
   1500          
   1501          //二位小数(全整数转浮点) 
   1502          u16 Hex2_FD1(u16 Value)  
   1503          {
   1504          	 u8 i;
   1505          	 i=16;
   1506          	 if(Value==0)
   1507          		 return 0xff80;  
   1508          	 while(Value<0x8000)
   1509          	 {
   1510          		 Value <<=1;
   1511          		 i--;
   1512          	 }
   1513          	 Value=Value&0xff00;  
   1514          	 Value+=i;            
   1515          	 return Value;
   1516          }
   1517          
   1518          //二位小数(14位整数,2位小数转浮点)
   1519          u16 Hex2_FD2(u16 Value)  
   1520          {
   1521          	 u8 i;
   1522          	 i=14;
   1523          	 if(Value==0)
   1524          		 return 0xff80;  
   1525          	 while(Value<0x8000)
   1526          	 {
   1527          		 Value <<=1;
   1528          		 i--;
   1529          	 }
   1530          	 Value=Value&0xff00;
   1531          	 Value+=i;
   1532          	 return Value;
   1533          }
