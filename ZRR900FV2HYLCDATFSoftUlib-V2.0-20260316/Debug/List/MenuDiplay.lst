    450          void Menu_Clear()
    451          {
    452          	u8 i;
    453          	
    454          	IDC.bReflash=0x5a;
    455          	for(i=0;i<9;i++)
    456          	{				
    457          		IDC.Page[i]=0;
    458          		IDC.Row[i]=0; 
    459          		IDC.Col[i]=0;
    460          		IDC.Star[i]=0;					
    461          	}
    462          	IDC.uStatus=0; 
    463          	IDC.CallDeep=0;		
    464          }
