   1815          	    	
   1816          	  		if (Sys_KC_Tab.uNowKCsts[tDoTab_Default[byTRIPLct].byNo-1] ==0xa5)		
   1817          	   			Lcd_WriteStr(j,15,4,(char *)name2_4,false);	//动作
   1818          	    	else 
   1819          	    		Lcd_WriteStr(j,15,4,(char *)name2_5,false);	//返回
   1820          		}//for				  
