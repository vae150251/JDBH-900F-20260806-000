   1906          		}
   1907          		else if(TEST==Available)
   1908          		{
   1909          			IDC.CallDeep=1;	
   1910          			IDC.bReflash=0x5a;
   1911          		}
   1912          		else
   1913          			return;
   1914          	}
   1915          	if(IDC.CallDeep==1)
   1916          	{
   1917          	  		if(!Set_QFTZ.Type)		//线路保护
   1918          			{
   1919          				pt=(u8*)&RUN_YB;
   1920          			}
   1921          #ifdef	ZRR900F		
