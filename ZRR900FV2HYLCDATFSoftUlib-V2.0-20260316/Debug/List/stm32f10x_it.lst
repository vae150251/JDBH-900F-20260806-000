    737          		RTimeOut[USART6_Prot]=100;			//字符间超时定值，默认时间长10ms，因为在线升级长报文传输时有个70ms左右延时，因此设为100，2021.5.4
    738          		USART_ClearITPendingBit(USART6, USART_IT_RXNE);		//清除中断标记位
