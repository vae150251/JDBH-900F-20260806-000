    622          /**
    623            * @brief  Setup the external memory controller. Called in startup_stm32f10x.s
    624            *          before jump to __main
    625            * @param  None
    626            * @retval None
    627            */
    628          #ifdef DATA_IN_ExtSRAM
    629          /**
    630            * @brief  Setup the external memory controller.
    631            *         Called in startup_stm32f10x_xx.s/.c before jump to main.
    632            * 	      This function configures the external SRAM mounted on STM3210E-EVAL
    633            *         board (STM32 High density devices). This SRAM will be used as program
    634            *         data memory (including heap and stack).
    635            * @param  None
    636            * @retval None
    637            */
    638          void SystemInit_ExtMemCtl(void)
    639          {
    640            /*!< FSMC Bank1 NOR/SRAM3 is used for the STM3210E-EVAL, if another Bank is
    641              required, then adjust the Register Addresses */
    642          
    643            /* Enable FSMC clock */
    644            RCC->AHBENR = 0x00000114;
    645          
    646            /* Enable GPIOD, GPIOE, GPIOF and GPIOG clocks */
    647            RCC->APB2ENR = 0x000001E0;
    648          
    649            /* ---------------  SRAM Data lines, NOE and NWE configuration ---------------*/
    650            /*----------------  SRAM Address lines configuration -------------------------*/
    651            /*----------------  NOE and NWE configuration --------------------------------*/
    652            /*----------------  NE3 configuration ----------------------------------------*/
    653            /*----------------  NBL0, NBL1 configuration ---------------------------------*/
    654          
    655            GPIOD->CRL = 0x44BB44BB;
    656            GPIOD->CRH = 0xBBBBBBBB;
    657          
    658            GPIOE->CRL = 0xB44444BB;
    659            GPIOE->CRH = 0xBBBBBBBB;
    660          
    661            GPIOF->CRL = 0x44BBBBBB;
    662            GPIOF->CRH = 0xBBBB4444;
    663          
    664            GPIOG->CRL = 0x44BBBBBB;
    665            GPIOG->CRH = 0x44444B44;
    666          
    667            /*----------------  FSMC Configuration ---------------------------------------*/
    668            /*----------------  Enable FSMC Bank1_SRAM Bank ------------------------------*/
    669          
    670            FSMC_Bank1->BTCR[4] = 0x00001011;
    671            FSMC_Bank1->BTCR[5] = 0x00000200;
    672          }
    673          #endif /* DATA_IN_ExtSRAM */
