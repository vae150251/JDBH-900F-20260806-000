    677          /**
    678            * @brief  Delay to wait HSE or PLL ready.
    679            * @note   This function should be used before reading RCC_CR_HSERDY flag.
    680            * @param  None
    681            * @retval None
    682            */
    683          static void WaitHseStbl(uint32_t delay)
    684          {
    685            uint32_t i;
    686          
    687            for(i = 0; i < delay; i++)
    688              ;
    689          }
    690          #endif
    691          #endif /* SYSCLK_FREQ_HSI */
    692          
    693          #ifdef SYSCLK_FREQ_HSE
    694          /**
    695            * @brief  Selects HSE as System clock source and configure HCLK, PCLK2
    696            *         and PCLK1 prescalers.
    697            * @note   This function should be used only after reset.
    698            * @param  None
    699            * @retval None
    700            */
    701          static void SetSysClockToHSE(void)
    702          {
    703            __IO uint32_t StartUpCounter = 0, HSEStatus = 0;
    704          
    705            /* SYSCLK, HCLK, PCLK2 and PCLK1 configuration ---------------------------*/
    706            /* Enable HSE */
    707            RCC->CR |= ((uint32_t)RCC_CR_HSEON);
    708          
    709            /* Wait till HSE is ready and if Time out is reached exit */
    710            do
    711            {
    712              HSEStatus = RCC->CR & RCC_CR_HSERDY;
    713              StartUpCounter++;
    714            }
    715            while((HSEStatus == 0) && (StartUpCounter != HSE_STARTUP_TIMEOUT));
    716          
    717            if ((RCC->CR & RCC_CR_HSERDY) != RESET)
    718            {
    719              HSEStatus = (uint32_t)0x01;
    720            }
    721            else
    722            {
    723              HSEStatus = (uint32_t)0x00;
    724            }
    725          
    726            if (HSEStatus == (uint32_t)0x01)
    727            {
    728          
    729              /* Enable Prefetch Buffer */
    730              FLASH->ACR |= FLASH_ACR_PRFTBE;
    731          
    732              /* Flash 0 wait state */
    733              FLASH->ACR &= (uint32_t)((uint32_t)~FLASH_ACR_LATENCY);
    734          
    735              if (HSE_VALUE <= 36000000)
    736              {
    737                FLASH->ACR |= (uint32_t)FLASH_ACR_LATENCY_0;
    738              }
    739              else
    740              {
    741                FLASH->ACR |= (uint32_t)FLASH_ACR_LATENCY_1;
    742              }
    743          
    744              /* HCLK = SYSCLK */
    745              RCC->CFGR |= (uint32_t)RCC_CFGR_HPRE_DIV1;
    746          
    747              /* PCLK2 = HCLK */
    748              RCC->CFGR |= (uint32_t)RCC_CFGR_PPRE2_DIV1;
    749          
    750              /* PCLK1 = HCLK */
    751              RCC->CFGR |= (uint32_t)RCC_CFGR_PPRE1_DIV1;
    752          
    753              /* Select HSE as system clock source */
    754              RCC->CFGR &= (uint32_t)((uint32_t)~(RCC_CFGR_SW));
    755              RCC->CFGR |= (uint32_t)RCC_CFGR_SW_HSE;
    756          
    757              /* Wait till HSE is used as system clock source */
    758              while ((RCC->CFGR & (uint32_t)RCC_CFGR_SWS) != (uint32_t)0x04)
    759              {
    760              }
    761            }
    762            else
    763            {
    764              /* If HSE fails to start-up, the application will have wrong clock
    765                   configuration. User can add here some code to deal with this error */
    766            }
    767          }
    768          #elif defined SYSCLK_FREQ_24MHz
    769          /**
    770            * @brief  Sets System clock frequency to 24MHz and configure HCLK, PCLK2
    771            *         and PCLK1 prescalers.
    772            * @note   This function should be used only after reset.
    773            * @param  None
    774            * @retval None
    775            */
    776          static void SetSysClockTo24(void)
    777          {
    778            __IO uint32_t StartUpCounter = 0, HSEStatus = 0;
    779          
    780            /* SYSCLK, HCLK, PCLK2 and PCLK1 configuration ---------------------------*/
    781            /* Enable HSE */
    782            RCC->CR |= ((uint32_t)RCC_CR_HSEON);
    783          
    784            /* Wait till HSE is ready and if Time out is reached exit */
    785            do
    786            {
    787              HSEStatus = RCC->CR & RCC_CR_HSERDY;
    788              StartUpCounter++;
    789            }
    790            while((HSEStatus == 0) && (StartUpCounter != HSE_STARTUP_TIMEOUT));
    791          
    792            if ((RCC->CR & RCC_CR_HSERDY) != RESET)
    793            {
    794              HSEStatus = (uint32_t)0x01;
    795            }
    796            else
    797            {
    798              HSEStatus = (uint32_t)0x00;
    799            }
    800          
    801            if (HSEStatus == (uint32_t)0x01)
    802            {
    803              /* Enable Prefetch Buffer */
    804              FLASH->ACR |= FLASH_ACR_PRFTBE;
    805          
    806              /* Flash 0 wait state */
    807              FLASH->ACR &= (uint32_t)((uint32_t)~FLASH_ACR_LATENCY);
    808              FLASH->ACR |= (uint32_t)FLASH_ACR_LATENCY_0;
    809          
    810              /* HCLK = SYSCLK */
    811              RCC->CFGR |= (uint32_t)RCC_CFGR_HPRE_DIV1;
    812          
    813              /* PCLK2 = HCLK */
    814              RCC->CFGR |= (uint32_t)RCC_CFGR_PPRE2_DIV1;
    815          
    816              /* PCLK1 = HCLK */
    817              RCC->CFGR |= (uint32_t)RCC_CFGR_PPRE1_DIV1;
    818          
    819              /*  PLL configuration:  = (HSE / 2) * 6 = 24 MHz */
    820              RCC->CFGR &= (uint32_t)((uint32_t)~(RCC_CFGR_PLLSRC | RCC_CFGR_PLLXTPRE | RCC_CFGR_PLLMULL));
    821              RCC->CFGR |= (uint32_t)(RCC_CFGR_PLLSRC_HSE | RCC_CFGR_PLLXTPRE_HSE_Div2 | RCC_CFGR_PLLMULL6);
    822          
    823              /* Enable PLL */
    824              RCC->CR |= RCC_CR_PLLON;
    825          
    826              /* Wait till PLL is ready */
    827              while((RCC->CR & RCC_CR_PLLRDY) == 0)
    828              {
    829              }
    830          
    831              /* Select PLL as system clock source */
    832              RCC->CFGR &= (uint32_t)((uint32_t)~(RCC_CFGR_SW));
    833              RCC->CFGR |= (uint32_t)RCC_CFGR_SW_PLL;
    834          
    835              /* Wait till PLL is used as system clock source */
    836              while ((RCC->CFGR & (uint32_t)RCC_CFGR_SWS) != (uint32_t)0x08)
    837              {
    838              }
    839            }
    840            else
    841            {
    842              /* If HSE fails to start-up, the application will have wrong clock
    843                   configuration. User can add here some code to deal with this error */
    844            }
    845          }
    846          #elif defined SYSCLK_FREQ_36MHz
    847          /**
    848            * @brief  Sets System clock frequency to 36MHz and configure HCLK, PCLK2
    849            *         and PCLK1 prescalers.
    850            * @note   This function should be used only after reset.
    851            * @param  None
    852            * @retval None
    853            */
    854          static void SetSysClockTo36(void)
    855          {
    856            __IO uint32_t StartUpCounter = 0, HSEStatus = 0;
    857          
    858            /* SYSCLK, HCLK, PCLK2 and PCLK1 configuration ---------------------------*/
    859            /* Enable HSE */
    860            RCC->CR |= ((uint32_t)RCC_CR_HSEON);
    861          
    862            /* Wait till HSE is ready and if Time out is reached exit */
    863            do
    864            {
    865              HSEStatus = RCC->CR & RCC_CR_HSERDY;
    866              StartUpCounter++;
    867            }
    868            while((HSEStatus == 0) && (StartUpCounter != HSE_STARTUP_TIMEOUT));
    869          
    870            if ((RCC->CR & RCC_CR_HSERDY) != RESET)
    871            {
    872              HSEStatus = (uint32_t)0x01;
    873            }
    874            else
    875            {
    876              HSEStatus = (uint32_t)0x00;
    877            }
    878          
    879            if (HSEStatus == (uint32_t)0x01)
    880            {
    881              /* Enable Prefetch Buffer */
    882              FLASH->ACR |= FLASH_ACR_PRFTBE;
    883          
    884              /* Flash 1 wait state */
    885              FLASH->ACR &= (uint32_t)((uint32_t)~FLASH_ACR_LATENCY);
    886              FLASH->ACR |= (uint32_t)FLASH_ACR_LATENCY_1;
    887          
    888              /* HCLK = SYSCLK */
    889              RCC->CFGR |= (uint32_t)RCC_CFGR_HPRE_DIV1;
    890          
    891              /* PCLK2 = HCLK */
    892              RCC->CFGR |= (uint32_t)RCC_CFGR_PPRE2_DIV1;
    893          
    894              /* PCLK1 = HCLK */
    895              RCC->CFGR |= (uint32_t)RCC_CFGR_PPRE1_DIV1;
    896          
    897              /*  PLL configuration: PLLCLK = (HSE / 2) * 9 = 36 MHz */
    898              RCC->CFGR &= (uint32_t)((uint32_t)~(RCC_CFGR_PLLSRC | RCC_CFGR_PLLXTPRE | RCC_CFGR_PLLMULL));
    899              RCC->CFGR |= (uint32_t)(RCC_CFGR_PLLSRC_HSE | RCC_CFGR_PLLXTPRE_HSE_Div2 | RCC_CFGR_PLLMULL9);
    900          
    901              /* Enable PLL */
    902              RCC->CR |= RCC_CR_PLLON;
    903          
    904              /* Wait till PLL is ready */
    905              while((RCC->CR & RCC_CR_PLLRDY) == 0)
    906              {
    907              }
    908          
    909              /* Select PLL as system clock source */
    910              RCC->CFGR &= (uint32_t)((uint32_t)~(RCC_CFGR_SW));
    911              RCC->CFGR |= (uint32_t)RCC_CFGR_SW_PLL;
    912          
    913              /* Wait till PLL is used as system clock source */
    914              while ((RCC->CFGR & (uint32_t)RCC_CFGR_SWS) != (uint32_t)0x08)
    915              {
    916              }
    917            }
    918            else
    919            {
    920              /* If HSE fails to start-up, the application will have wrong clock
    921                   configuration. User can add here some code to deal with this error */
    922            }
    923          }
    924          #elif defined SYSCLK_FREQ_48MHz
    925          /**
    926            * @brief  Sets System clock frequency to 48MHz and configure HCLK, PCLK2
    927            *         and PCLK1 prescalers.
    928            * @note   This function should be used only after reset.
    929            * @param  None
    930            * @retval None
    931            */
    932          static void SetSysClockTo48(void)
    933          {
    934            __IO uint32_t StartUpCounter = 0, HSEStatus = 0;
    935          
    936            /* SYSCLK, HCLK, PCLK2 and PCLK1 configuration ---------------------------*/
    937            /* Enable HSE */
    938            RCC->CR |= ((uint32_t)RCC_CR_HSEON);
    939          
    940            /* Wait till HSE is ready and if Time out is reached exit */
    941            do
    942            {
    943              HSEStatus = RCC->CR & RCC_CR_HSERDY;
    944              StartUpCounter++;
    945            }
    946            while((HSEStatus == 0) && (StartUpCounter != HSE_STARTUP_TIMEOUT));
    947          
    948            if ((RCC->CR & RCC_CR_HSERDY) != RESET)
    949            {
    950              HSEStatus = (uint32_t)0x01;
    951            }
    952            else
    953            {
    954              HSEStatus = (uint32_t)0x00;
