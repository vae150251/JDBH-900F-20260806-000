    118          /* #define SYSCLK_FREQ_176MHz       176000000 */
    119          /* #define SYSCLK_FREQ_192MHz       192000000 */
    120          /* #define SYSCLK_FREQ_200MHz       200000000 */
    121          /* #define SYSCLK_FREQ_224MHz       224000000 */
    122          /* #define SYSCLK_FREQ_240MHz       240000000 */
    123          /* #define SYSCLK_FREQ_24MHz_HSI    24000000 */
