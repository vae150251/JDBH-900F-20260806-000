    327          
    328          /**
    329            * @brief  Setup the microcontroller system
    330            *         Initialize the Embedded Flash Interface, the PLL and update the
    331            *         SystemCoreClock variable.
    332            * @note   This function should be used only after reset.
    333            * @param  None
    334            * @retval None
    335            */
    336          void SystemInit (void)
    337          {
    338            /* Enable FPU*/
    339          #if defined (__FPU_USED) && (__FPU_USED == 1U)
    340            SCB->CPACR |= ((3U << 10U * 2U) |         /* set CP10 Full Access */
    341                           (3U << 11U * 2U)  );       /* set CP11 Full Access */
    342          #endif
    343          
    344            /* Reset the RCC clock configuration to the default reset state(for debug purpose) */
    345            /* Set HSION bit */
    346            RCC->CR |= (uint32_t)0x00000001;
    347          
    348            /* Reset CFGR */
    349            RCC->CFGR &= (uint32_t)0x00000000;
    350          
    351            /* Reset HSEON, CSSON and PLLON bits */
    352            RCC->CR &= (uint32_t)0xFEF6FFFF;
    353          
    354            /* Reset HSEBYP bit */
    355            RCC->CR &= (uint32_t)0xFFFBFFFF;
    356          
    357          #ifdef STM32F10X_CL
    358            /* Reset PLL2ON and PLL3ON bits */
    359            RCC->CR &= (uint32_t)0xEBFFFFFF;
    360          
    361            /* Disable all interrupts and clear pending bits  */
    362            RCC->CIR = 0x00FF0000;
    363          
    364            /* Reset CFGR2 register */
    365            RCC->CFGR2 = 0x00000000;
    366          #elif defined (STM32F10X_LD_VL) || defined (STM32F10X_MD_VL) || (defined STM32F10X_HD_VL)
    367            /* Disable all interrupts and clear pending bits  */
    368            RCC->CIR = 0x009F0000;
    369          
    370            /* Reset CFGR2 register */
    371            RCC->CFGR2 = 0x00000000;
    372          #else
    373            /* Disable all interrupts and clear pending bits  */
    374            RCC->CIR = 0x009F0000;
    375          #endif /* STM32F10X_CL */
    376          
    377          #if defined (STM32F10X_HD) || (defined STM32F10X_XL) || (defined STM32F10X_HD_VL)
    378          #ifdef DATA_IN_ExtSRAM
    379            SystemInit_ExtMemCtl();
    380          #endif /* DATA_IN_ExtSRAM */
    381          #endif
    382          
    383            /* Configure the System clock frequency, HCLK, PCLK2 and PCLK1 prescalers */
    384            /* Configure the Flash Latency cycles and enable prefetch buffer */
    385            SetSysClock();
    386          
    387          #ifdef VECT_TAB_SRAM
    388            SCB->VTOR = SRAM_BASE | VECT_TAB_OFFSET; /* Vector Table Relocation in Internal SRAM. */
    389          #else
    390            SCB->VTOR = FLASH_BASE | VECT_TAB_OFFSET; /* Vector Table Relocation in Internal FLASH. */
    391          #endif
    392          }
    393          
    394          /**
    395            * @brief  Update SystemCoreClock variable according to Clock Register Values.
    396            *         The SystemCoreClock variable contains the core clock (HCLK), it can
    397            *         be used by the user application to setup the SysTick timer or configure
    398            *         other parameters.
    399            *
    400            * @note   Each time the core clock (HCLK) changes, this function must be called
    401            *         to update SystemCoreClock variable value. Otherwise, any configuration
    402            *         based on this variable will be incorrect.
    403            *
    404            * @note   - The system frequency computed by this function is not the real
    405            *           frequency in the chip. It is calculated based on the predefined
    406            *           constant and the selected clock source:
    407            *
    408            *           - If SYSCLK source is HSI, SystemCoreClock will contain the HSI_VALUE(*)
    409            *
    410            *           - If SYSCLK source is HSE, SystemCoreClock will contain the HSE_VALUE(**)
    411            *
    412            *           - If SYSCLK source is PLL, SystemCoreClock will contain the HSE_VALUE(**)
    413            *             or HSI_VALUE(*) multiplied by the PLL factors.
    414            *
    415            *         (*) HSI_VALUE is a constant defined in stm32f1xx.h file (default value
    416            *             8 MHz) but the real value may vary depending on the variations
    417            *             in voltage and temperature.
    418            *
    419            *         (**) HSE_VALUE is a constant defined in stm32f1xx.h file (default value
    420            *              8 MHz or 25 MHz, depedning on the product used), user has to ensure
    421            *              that HSE_VALUE is same as the real frequency of the crystal used.
    422            *              Otherwise, this function may have wrong result.
    423            *
    424            *         - The result of this function could be not correct when using fractional
    425            *           value for HSE crystal.
    426            * @param  None
    427            * @retval None
    428            */
    429          void SystemCoreClockUpdate (void)
    430          {
    431            uint32_t tmp = 0, pllmull = 0, pllsource = 0;
    432          
    433          #ifdef  STM32F10X_CL
    434            uint32_t prediv1source = 0, prediv1factor = 0, prediv2factor = 0, pll2mull = 0;
    435          #endif /* STM32F10X_CL */
    436          
    437          #if defined (STM32F10X_LD_VL) || defined (STM32F10X_MD_VL) || (defined STM32F10X_HD_VL)
    438            uint32_t prediv1factor = 0;
    439          #endif /* STM32F10X_LD_VL or STM32F10X_MD_VL or STM32F10X_HD_VL */
    440          
    441            /* Get SYSCLK source -------------------------------------------------------*/
    442            tmp = RCC->CFGR & RCC_CFGR_SWS;
    443          
    444            switch (tmp)
    445            {
    446            case 0x00:  /* HSI used as system clock */
    447              SystemCoreClock = HSI_VALUE;
    448              break;
    449          
    450            case 0x04:  /* HSE used as system clock */
    451              SystemCoreClock = HSE_VALUE;
    452              break;
    453          
    454            case 0x08:  /* PLL used as system clock */
    455          
    456              /* Get PLL clock source and multiplication factor ----------------------*/
    457              pllmull = RCC->CFGR & RCC_CFGR_PLLMULL;
    458              pllsource = RCC->CFGR & RCC_CFGR_PLLSRC;
    459          
    460          #ifndef STM32F10X_CL
    461              pllmull = RCC_GET_PLLMULT(pllmull);
    462          
    463              if (pllsource == 0x00)
    464              {
    465                /* HSI oscillator clock divided by 2 selected as PLL clock entry */
    466                SystemCoreClock = (HSI_VALUE >> 1) * pllmull;
    467              }
    468              else
    469              {
    470          #if defined (STM32F10X_LD_VL) || defined (STM32F10X_MD_VL) || (defined STM32F10X_HD_VL)
    471                prediv1factor = (RCC->CFGR2 & RCC_CFGR2_PREDIV1) + 1;
    472                /* HSE oscillator clock selected as PREDIV1 clock entry */
    473                SystemCoreClock = (HSE_VALUE / prediv1factor) * pllmull;
    474          #else
    475          
    476                /* HSE selected as PLL clock entry */
    477                if ((RCC->CFGR & RCC_CFGR_PLLXTPRE) != (uint32_t)RESET)
    478                {
    479                  /* HSE oscillator clock divided by 2 */
    480                  SystemCoreClock = (HSE_VALUE >> 1) * pllmull;
    481                }
    482                else
    483                {
    484                  SystemCoreClock = HSE_VALUE * pllmull;
    485                }
    486          
    487          #endif
    488              }
    489          
    490          #else
    491              pllmull = pllmull >> 18;
    492          
    493              if (pllmull != 0x0D)
    494              {
    495                pllmull += 2;
    496              }
    497              else
    498              {
    499                /* PLL multiplication factor = PLL input clock * 6.5 */
    500                pllmull = 13 / 2;
    501              }
    502          
    503              if (pllsource == 0x00)
    504              {
    505                /* HSI oscillator clock divided by 2 selected as PLL clock entry */
    506                SystemCoreClock = (HSI_VALUE >> 1) * pllmull;
    507              }
    508              else
    509              {
    510                /* PREDIV1 selected as PLL clock entry */
    511          
    512                /* Get PREDIV1 clock source and division factor */
    513                prediv1source = RCC->CFGR2 & RCC_CFGR2_PREDIV1SRC;
    514                prediv1factor = (RCC->CFGR2 & RCC_CFGR2_PREDIV1) + 1;
    515          
    516                if (prediv1source == 0)
    517                {
    518                  /* HSE oscillator clock selected as PREDIV1 clock entry */
    519                  SystemCoreClock = (HSE_VALUE / prediv1factor) * pllmull;
    520                }
    521                else
    522                {
    523                  /* PLL2 clock selected as PREDIV1 clock entry */
    524          
    525                  /* Get PREDIV2 division factor and PLL2 multiplication factor */
    526                  prediv2factor = ((RCC->CFGR2 & RCC_CFGR2_PREDIV2) >> 4) + 1;
    527                  pll2mull = ((RCC->CFGR2 & RCC_CFGR2_PLL2MUL) >> 8 ) + 2;
    528                  SystemCoreClock = (((HSE_VALUE / prediv2factor) * pll2mull) / prediv1factor) * pllmull;
    529                }
    530              }
    531          
    532          #endif /* STM32F10X_CL */
    533              break;
    534          
    535            default:
    536              SystemCoreClock = HSI_VALUE;
    537              break;
    538            }
    539          
    540            /* Compute HCLK clock frequency ----------------*/
    541            /* Get HCLK prescaler */
    542            tmp = AHBPrescTable[((RCC->CFGR & RCC_CFGR_HPRE) >> 4)];
    543            /* HCLK clock frequency */
    544            SystemCoreClock >>= tmp;
    545          }
    546          
    547          /**
    548            * @brief  Configures the System clock frequency, HCLK, PCLK2 and PCLK1 prescalers.
    549            * @param  None
    550            * @retval None
    551            */
    552          static void SetSysClock(void)
    553          {
    554          #ifdef SYSCLK_FREQ_HSE
    555            SetSysClockToHSE();
    556          #elif defined SYSCLK_FREQ_24MHz
    557            SetSysClockTo24();
    558          #elif defined SYSCLK_FREQ_36MHz
    559            SetSysClockTo36();
    560          #elif defined SYSCLK_FREQ_48MHz
    561            SetSysClockTo48();
    562          #elif defined SYSCLK_FREQ_56MHz
    563            SetSysClockTo56();
    564          #elif defined SYSCLK_FREQ_72MHz
    565            SetSysClockTo72();
    566          #elif defined SYSCLK_FREQ_96MHz
    567            SetSysClockTo96();
    568          #elif defined SYSCLK_FREQ_108MHz
    569            SetSysClockTo108();
    570          #elif defined SYSCLK_FREQ_120MHz
    571            SetSysClockTo120();
    572          #elif defined SYSCLK_FREQ_144MHz
    573            SetSysClockTo144();
    574          #elif defined SYSCLK_FREQ_168MHz
    575            SetSysClockTo168();
    576          #elif defined SYSCLK_FREQ_176MHz
    577            SetSysClockTo176();
    578          #elif defined SYSCLK_FREQ_192MHz
    579            SetSysClockTo192();
    580          #elif defined SYSCLK_FREQ_200MHz
    581            SetSysClockTo200();
    582          #elif defined SYSCLK_FREQ_224MHz
    583            SetSysClockTo224();
    584          #elif defined SYSCLK_FREQ_240MHz
    585            SetSysClockTo240();
    586          #elif defined SYSCLK_FREQ_24MHz_HSI
    587            SetSysClockTo24MHSI();
    588          #elif defined SYSCLK_FREQ_36MHz_HSI
    589            SetSysClockTo36MHSI();
    590          #elif defined SYSCLK_FREQ_48MHz_HSI
    591            SetSysClockTo48MHSI();
    592          #elif defined SYSCLK_FREQ_56MHz_HSI
    593            SetSysClockTo56MHSI();
    594          #elif defined SYSCLK_FREQ_72MHz_HSI
    595            SetSysClockTo72MHSI();
    596          #elif defined SYSCLK_FREQ_96MHz_HSI
    597            SetSysClockTo96MHSI();
    598          #elif defined SYSCLK_FREQ_108MHz_HSI
    599            SetSysClockTo108MHSI();
    600          #elif defined SYSCLK_FREQ_120MHz_HSI
    601            SetSysClockTo120MHSI();
    602          #elif defined SYSCLK_FREQ_144MHz_HSI
    603            SetSysClockTo144MHSI();
    604          #elif defined SYSCLK_FREQ_168MHz_HSI
    605            SetSysClockTo168MHSI();
    606          #elif defined SYSCLK_FREQ_176MHz_HSI
    607            SetSysClockTo176MHSI();
    608          #elif defined SYSCLK_FREQ_192MHz_HSI
    609            SetSysClockTo192MHSI();
    610          #elif defined SYSCLK_FREQ_200MHz_HSI
    611            SetSysClockTo200MHSI();
    612          #elif defined SYSCLK_FREQ_224MHz_HSI
    613            SetSysClockTo224MHSI();
    614          #elif defined SYSCLK_FREQ_240MHz_HSI
    615            SetSysClockTo240MHSI();
    616          #endif
    617          
    618            /* If none of the define above is enabled, the HSI is used as System clock
    619               source (default after reset) */
    620          }
